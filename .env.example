# ==========================================================================
# PromptQuest 環境変数のサンプル
# このファイルを .env にコピーして、実際の値を設定してください。
#   cp .env.example .env
# .env は .gitignore に含まれているため、コミットされません。
# ==========================================================================

# --- GitHub Models ---
# GitHub Models の Personal Access Token（models:read 権限が必要）。
# https://github.com/settings/personal-access-tokens から発行できます。
GITHUB_TOKEN=your_github_models_token_here

# GitHub Models の推論エンドポイント（OpenAI 互換）
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference/chat/completions

# 利用するモデル名
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# --- サーバー設定 ---
# アプリを起動するポート番号
PORT=3000

# デフォルト言語（ja または en）
DEFAULT_LOCALE=ja
